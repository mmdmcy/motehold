# Copy this file to .env for local settings.
# Do not commit .env.

# Leave blank to auto-detect a Tailscale IPv4 address, then fall back to 127.0.0.1.
MOTEHOLD_HOST=
MOTEHOLD_PORT=8787
MOTEHOLD_DB=.local/messages.db

# Set to 1 only if you want HTTP request logs. Request logs may include client IPs.
MOTEHOLD_LOG_REQUESTS=0
